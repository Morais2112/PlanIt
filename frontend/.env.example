# Copie este arquivo para .env se precisar apontar para outro backend.
#   cp .env.example .env
#
# ATENCAO: toda variavel VITE_* e embutida no bundle no momento do build
# e fica visivel para qualquer pessoa que abrir o site. Nunca coloque
# segredo aqui — chave de API, senha ou token vao para o backend.

# URL publica da API. Sem isto, o app usa o backend local.
VITE_API_URL=http://localhost:3001/api
