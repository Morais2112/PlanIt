# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env
#
# O .env e lido automaticamente pelo server.js e NAO vai para o versionamento.
# Em producao, defina estas variaveis direto no painel do provedor.

# Chave usada para assinar os tokens JWT.
# Em producao e obrigatoria: o servidor se recusa a subir sem ela.
# Gere uma aleatoria com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave-em-producao

# Porta do servidor.
PORT=3001

# Origens liberadas no CORS, separadas por virgula.
# O padrao ja cobre o dev server e o preview do Vite.
# Em producao, liste apenas o dominio do seu frontend.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
